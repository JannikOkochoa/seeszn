# ─── Email delivery (Resend) ──────────────────────────────────────────────────
# Required for the Sichtbarkeitsprüfung delivery. The free scan works without it;
# only the full-diagnosis email + internal lead need these.
# Fehlt RESEND_API_KEY, geht kein Lead mehr verloren (er landet in Supabase),
# aber es kommt auch keine Benachrichtigung an — der Lead steht dann mit
# email_delivery_status = 'failed' in public.leads.
RESEND_API_KEY=
SEESZN_LEAD_EMAIL=elana@seeszn.com
SEESZN_FROM_EMAIL="Elana von SEESZN <elana@seeszn.com>"
SEESZN_REPLY_TO_EMAIL=elana@seeszn.com

# ─── Supabase — Lead-Persistierung ────────────────────────────────────────────
# public.leads ist die Source of Truth für alle Anfragen aus /diagnosis/result
# und /brief/ki-sichtbarkeit. Der Server schreibt mit dem Secret Key
# (service_role); anon und authenticated haben keinerlei Zugriff.
# Diese drei Variablen müssen in Production gesetzt sein, sonst gibt es keinen
# Lead-Schutz bei einem Mail-Ausfall.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ─── KI-Antwortfragen — Web-Signalcheck ───────────────────────────────────────
# AI_ANSWER_PROVIDER=none      generates the 3 KI-Antwortfragen without any live
#                              web checks (questions returned with checked=false).
# AI_ANSWER_PROVIDER=google_cse runs exactly 3 Google Custom Search queries per
#                              scan, one per question. This is a Web-Signalcheck of
#                              the visible web surface, NOT a live ChatGPT, Gemini,
#                              Perplexity or Google AI Overview ranking.
AI_ANSWER_PROVIDER=none
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# ─── Brief-request webhook (optional) ────────────────────────────────────────
# POST target for /api/brief-request submissions (e.g. a Make/Zapier webhook or
# your own endpoint). If unset, submissions are logged server-side but not forwarded.
BRIEF_REQUEST_WEBHOOK_URL=

# ─── Client Rooms ─────────────────────────────────────────────────────────────
# Zugangspasswort für den privaten Klühspies-Raum (/kluehspies-room).
# Ohne Env-Variable greift der markierte Übergangs-Fallback im Code.
KLUEHSPIES_ROOM_PASSWORD=

# ─── Entwicklung: Team-Bootstrap ──────────────────────────────────────────────
# Passwort der example.com-Testkonten aus scripts/dev-bootstrap-team.mjs.
# Nur lokal/Dev setzen; niemals ein echtes Passwort committen. Fehlt die
# Variable, bricht das Bootstrap-Script bewusst ab.
DEV_BOOTSTRAP_PASSWORD=

# ─── Google Search Console API (Read-only, serverseitig) ──────────────────────
# Live-Anbindung für die tägliche Aktualisierung der GSC-Zahlen im Klühspies
# Room über /api/sync/gsc/cron. Ausschließlich serverseitig, niemals
# NEXT_PUBLIC_. Der Access Token wird aus dem Refresh Token automatisch erneuert
# und nie gespeichert. Scope: webmasters.readonly.
GOOGLE_GSC_CLIENT_ID=
GOOGLE_GSC_CLIENT_SECRET=
GOOGLE_GSC_REFRESH_TOKEN=
# Property exakt wie in der Search Console, z. B. "sc-domain:example.de" oder
# "https://www.example.de/".
GOOGLE_GSC_PROPERTY=
# Eigenes Secret zum Absichern des Cron-Endpunkts /api/sync/gsc/cron.
GSC_SYNC_SECRET=
# Optional: Ladefenster in Tagen (Default 200; deckt 90 Tage + Vorperiode ab).
GSC_SYNC_WINDOW_DAYS=
#
# Es braucht KEINEN externen Cronjob. Der Zeitplan liegt in Supabase
# (pg_cron + pg_net), siehe den Abschnitt „Automatisierung" weiter unten.
#
# GSC_SYNC_SECRET wird zusätzlich im Supabase Vault hinterlegt; der
# Cron-Endpunkt akzeptiert beide Quellen. Dadurch kann diese Env-Variable nicht
# mehr unbemerkt vom Scheduler abweichen.
#
# Zustand jederzeit prüfen (ohne einen Sync auszulösen):
#
#   curl -H "x-gsc-sync-secret: $GSC_SYNC_SECRET" \
#     https://<domain>/api/sync/gsc/status

# ─── Automatisierung: läuft in Supabase, nicht hier ───────────────────────────
# Der tägliche Sync wird von Supabase (pg_cron) angestoßen, nicht von einem
# externen Cronjob. Endpoint und Secret liegen im Supabase Vault; gesetzt
# werden sie einmalig mit den Werten aus dieser Env:
#
#   node scripts/setup-gsc-automation.mjs
#
# Jobs (pg_cron): kluehspies-gsc-daily-sync (06:00 UTC),
# kluehspies-gsc-self-heal (stündlich, löst nur bei echtem Rückstand aus),
# kluehspies-gsc-reconcile (alle 5 Min., prüft die Zustellung).
# Zustand jederzeit prüfbar über GET /api/sync/gsc/status.

# ─── GA4 (noch nicht verbunden) ───────────────────────────────────────────────
# Die GA4 Data API verlangt den Scope analytics.readonly. Der vorhandene
# Search-Console-Refresh-Token trägt ihn nicht (geprüft: die API antwortet mit
# ACCESS_TOKEN_SCOPE_INSUFFICIENT). Nötig ist eine einmalige Google-Zustimmung
# für analytics.readonly; daraus entsteht ein eigener Refresh Token.
#
# Sind die drei Werte gesetzt, meldet das Dashboard Analytics als verbunden;
# solange sie fehlen, steht dort ehrlich „Noch nicht verbunden". Es erscheinen
# in keinem Fall geschätzte oder erfundene Zahlen.
GA4_PROPERTY_ID=
GA4_REFRESH_TOKEN=
# Optional: eigener OAuth-Client. Ohne diese beiden werden GOOGLE_GSC_CLIENT_ID
# und GOOGLE_GSC_CLIENT_SECRET verwendet — der Refresh Token muss aber in
# jedem Fall aus einer Zustimmung mit analytics.readonly stammen.
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=

# ─── Legacy: Demo-Sync (deaktiviert) ──────────────────────────────────────────
# POST /api/sync/gsc erzeugt synthetische Demo-Daten. Seit dem GSC-Export-Import
# ist er standardmäßig aus (410 Gone). Nur auf "true" setzen, wenn die alte
# Demo-Basis bewusst wieder befüllt werden soll. Kein NEXT_PUBLIC_.
LEGACY_GSC_DEMO_SYNC_ENABLED=false

# ─── Optional ─────────────────────────────────────────────────────────────────
# Free PageSpeed Insights signal for the scan (best effort, never blocks a scan).
PAGESPEED_API_KEY=
